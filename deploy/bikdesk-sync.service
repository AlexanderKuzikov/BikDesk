[Unit]
Description=BikDesk nightly BIK sync
After=network.target postgresql.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/bikdesk
EnvironmentFile=/home/deploy/bikdesk/.env
ExecStart=/home/deploy/bikdesk/.venv/bin/python /home/deploy/bikdesk/src/sync.py --out /home/deploy/bikdesk/data --check
StandardOutput=journal
StandardError=journal
